      <a class="btn btn-white btn-lg" href="/en/contact/" data-magnetic><span>Book my call <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
