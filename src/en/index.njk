    </div>
    <div class="formules">
      <div class="formule">
        <h3>Light</h3>
        <p class="aud">Independent travelers</p>
        <div class="price"><span class="price-chf" data-chf="35">35 CHF</span> <small>/ day</small></div>
        <p class="price-note">per day of organized travel</p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Tailor-made itinerary</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Selection of local activities &amp; experiences</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Transport selection for each stop</li>
