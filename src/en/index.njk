{% block content %}{% raw %}
<!-- ============ HERO ÉDITORIAL ============ -->
<section class="home-hero" data-screen-label="Hero">
  <div class="container">
    <div class="home-hero-inner">
      <!-- Left column: Editorial text -->
      <div class="hero-editorial-left">
        <!-- Live pulsing geo-badge -->
        <div class="geo-badge">
          <span class="geo-dot" aria-hidden="true"></span>
          <span>Koh Lanta, Thailand &middot; 7°39'N 99°02'E</span>
        </div>

        <p class="eyebrow" style="margin-bottom:20px">Travel Planner &middot; On the ground since 2021</p>

        <h1>
          Tailor-made trips,<br>
          crafted with <em>heart.</em>
        </h1>

        <p class="hero-tagline">I don't sell catalog tours. I compose your ideal journey — at your pace, matching your style and budget — with the local insight and care of a friend on the ground.</p>

        <!-- Anaïs signature -->
        <div class="hero-signature" aria-label="Signature Anaïs Zwald">
          <span class="sig-hand">Anaïs Zwald</span>
          <svg class="sig-flourish" viewBox="0 0 64 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M2 5 C16 1, 38 9, 62 3" />
          </svg>
        </div>

        <div class="hero-editorial-btns">
          <a class="btn btn-teal btn-lg" href="/en/contact/" data-magnetic>
            <span>Plan my trip
              <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </a>
          <a class="btn btn-white btn-lg" href="/en/a-propos/">
            <span>Discover Anaïs</span>
          </a>
        </div>
      </div>

      <!-- Right column: Layered photographic composition -->
      <div class="hero-editorial-right">
        <!-- Main landscape card -->
        <div class="hero-scene-card">
          <img fetchpriority="high" src="/images/IMG_6424.jpg" alt="View over the Andaman Sea islands, Thailand" width="1200" height="900">
        </div>

        <!-- Anaïs portrait polaroid -->
        <div class="anais-portrait-wrap">
          <img fetchpriority="high" src="/images/IMG_5300.jpg" alt="Anaïs Zwald, Travel Planner in Koh Lanta, Thailand" width="800" height="1067">
          <div class="portrait-caption">Anaïs · Koh Lanta, Thailand</div>
        </div>

        <!-- Vintage passport stamp SVG -->
        <div class="stamp-circle" aria-hidden="true">
          <svg viewBox="0 0 120 120" fill="none">
            <circle cx="60" cy="60" r="54" stroke="#0A828D" stroke-width="2" stroke-dasharray="4 3" fill="rgba(255,255,255,0.92)"/>
            <circle cx="60" cy="60" r="46" stroke="#0A828D" stroke-width="1" fill="none"/>
            <defs>
              <path id="topArcEn" d="M 60,60 m -36,0 a 36,36 0 1,1 72,0" />
              <path id="botArcEn" d="M 60,60 m -34,0 a 34,34 0 1,0 68,0" />
            </defs>
            <text font-family="Manrope, sans-serif" font-size="7.2" font-weight="700" letter-spacing="3" fill="#0A828D" text-anchor="middle">
              <textPath href="#topArcEn" startOffset="50%">ON THE GROUND · 3+ YRS</textPath>
            </text>
            <text font-family="Manrope, sans-serif" font-size="6.8" font-weight="600" letter-spacing="2.2" fill="#0A828D" text-anchor="middle">
              <textPath href="#botArcEn" startOffset="50%">KOH LANTA · THAILAND</textPath>
            </text>
            <text x="60" y="56" text-anchor="middle" font-family="Cormorant Garamond, serif" font-size="15" font-weight="600" fill="#0A828D" font-style="italic">Zwald</text>
            <text x="60" y="69" text-anchor="middle" font-family="Manrope, sans-serif" font-size="6.2" font-weight="700" letter-spacing="1.2" fill="#0A828D">TRAVEL PLANNER</text>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ TRUST BAR ============ -->
<section class="trust-bar">
  <div class="container">
    <span class="ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h0M15 9h0M9 13h0M15 13h0"/></svg> 3+ years on the ground</span>
    <span class="sep"></span>
    <a class="ti" href="https://maps.app.goo.gl/F81WUgeET6vPxjNs8" target="_blank" rel="noopener" aria-label="Google reviews 5/5 — view listing on Google Maps"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.8 6.1 20.8l1.2-6.6L2.5 9l6.6-.9z"/></svg> Google reviews 5/5</a>
    <span class="sep"></span>
    <span class="ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> No commission, total freedom</span>
    <span class="sep"></span>
    <span class="ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.4 8.4 0 01-1.2 4.4A8.5 8.5 0 0112.5 20a8.4 8.4 0 01-4.4-1.2L3 20l1.3-5a8.4 8.4 0 01-1.3-4.5A8.5 8.5 0 017.6 3.2 8.4 8.4 0 0112 2a8.5 8.5 0 019 9.5z"/></svg> Daily WhatsApp assistance</span>
  </div>
</section>

<!-- ============ STATS ============ -->
<section class="bg-navy section-pad">
  <div class="container">
    <div class="stats">
      <div class="stat" data-reveal data-reveal-delay="1"><div class="num"><span data-count="50" data-suffix="+">0</span></div><div class="lbl">Travelers guided</div></div>
      <div class="stat" data-reveal data-reveal-delay="2"><div class="num"><span data-count="3" data-suffix="+">0</span></div><div class="lbl">Years on the ground</div></div>
      <div class="stat" data-reveal data-reveal-delay="3"><div class="num"><span data-count="5">0</span>/5</div><div class="lbl"><a href="https://maps.app.goo.gl/F81WUgeET6vPxjNs8" target="_blank" rel="noopener">Google reviews</a></div></div>
      <div class="stat" data-reveal data-reveal-delay="4"><div class="num"><span data-count="100" data-suffix="%">0</span></div><div class="lbl">Unique itineraries</div></div>
    </div>
  </div>
</section>

<!-- ============ BENTO GRID ============ -->
<section class="section-pad">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">The Zwald Approach</p>
      <h2>Why choose a travel planner <em>on the ground</em>?</h2>
      <p>Not a travel agency, not a standardized catalog. A local eye, a genuine human relationship from your first message until you return home.</p>
    </div>
    <div class="bento-grid">
      <!-- Block A: Field photo -->
      <div class="bento-a" data-reveal>
        <img loading="lazy" decoding="async" src="/images/IMG_5519.jpg" alt="Anaïs exploring the mangroves in Koh Lanta, Thailand" width="1200" height="800">
        <div class="bento-overlay" aria-hidden="true"></div>
        <div class="bento-content">
          <div class="bento-badge">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="5"/></svg>
            On the ground
          </div>
          <blockquote>&ldquo;Every address I recommend, I've vetted myself. Every itinerary, I've lived it.&rdquo;</blockquote>
        </div>
      </div>

      <!-- Block B: 0% commission -->
      <div class="bento-b" data-reveal data-reveal-delay="1">
        <div>
          <div class="bento-zero">0%</div>
          <div class="bento-b-title">Commission. Ever.</div>
          <p>You book everything directly with complete freedom. I advise you with zero conflict of interest — my only goal is your dream journey.</p>
        </div>
        <a class="bento-arrow-link" href="/en/services/">
          My services
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <!-- Block C: Digital roadbook -->
      <div class="bento-c" data-reveal data-reveal-delay="2">
        <div class="bento-c-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 5a2 2 0 012-2h9l5 5v11a2 2 0 01-2 2H6a2 2 0 01-2-2z"/><path d="M14 3v5h5M8 13h8M8 17h5"/></svg>
        </div>
        <h3>Your digital travel roadbook</h3>
        <p>Day-by-day itinerary, direct booking links, insider local spots, and practical cultural advice. Accessible anywhere, even offline.</p>
        <a class="text-link" href="/en/services/">See what's included <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>

      <!-- Block D: WhatsApp live conversation -->
      <div class="bento-d" data-reveal data-reveal-delay="3">
        <div class="wa-header">
          <img class="wa-avatar" src="/images/thumbs/IMG_5300-700.webp" alt="Anaïs Zwald" width="46" height="46">
          <div>
            <div class="wa-name">Anaïs <span class="online" aria-label="Online"></span></div>
            <div class="wa-status">Travel Planner · Koh Lanta</div>
          </div>
        </div>
        <div class="wa-convo" role="log" aria-label="Example conversation with Anaïs">
          <div class="wa-msg received">
            Hi Sophie! 🌴 The sea looks pristine today, I spoke with Somchai for your private boat at 10 AM. Have an amazing snorkeling trip!
            <span class="wa-time">09:42</span>
          </div>
          <div class="wa-msg sent">
            Anaïs you're wonderful, thank you so much for everything ❤️
            <span class="wa-time">09:48</span>
          </div>
          <div class="wa-msg received">
            My pleasure! Don't forget sunscreen 😄 I'm on WhatsApp if you need anything.
            <span class="wa-time">09:50</span>
          </div>
        </div>
        <p class="wa-caption">Available 7 days a week during your stay — a trusted friend on the ground.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ PHOTO MARQUEE ============ -->
<section class="marquee" aria-label="Photo gallery">
  <div class="marquee-track">
    <div class="marquee-item" data-lightbox data-src="/images/IMG_1369.jpg" data-caption="Coconut break facing the Andaman Sea, Krabi"><picture><source type="image/webp" srcset="/images/thumbs/IMG_1369-700.webp"><img loading="lazy" decoding="async" src="/images/IMG_1369.jpg" alt="Coconut break facing the Andaman Sea, Krabi"></picture><span class="cap">Krabi · Andaman Sea</span></div>
