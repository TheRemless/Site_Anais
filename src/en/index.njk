    <div class="marquee-item" data-lightbox data-src="/images/IMG_5227.jpg" data-caption="Golden temple of Doi Suthep, Chiang Mai"><picture><source type="image/webp" srcset="/images/thumbs/IMG_5227-700.webp"><img loading="lazy" decoding="async" src="/images/IMG_5227.jpg" alt="Golden temple of Doi Suthep, Chiang Mai"></picture><span class="cap">Doi Suthep · Chiang Mai</span></div>
