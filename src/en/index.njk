    <div class="marquee-item" data-lightbox data-src="/images/IMG_4231.jpg" data-caption="Turquoise waters of Koh Tao"><picture><source type="image/webp" srcset="/images/thumbs/IMG_4231-700.webp"><img loading="lazy" decoding="async" src="/images/IMG_4231.jpg" alt="Turquoise waters of Koh Tao"></picture><span class="cap">Koh Tao</span></div>
    <div class="marquee-item" data-lightbox data-src="/images/IMG_2016.jpg" data-caption="Sunset on Koh Lanta beach"><picture><source type="image/webp" srcset="/images/thumbs/IMG_2016-700.webp"><img loading="lazy" decoding="async" src="/images/IMG_2016.jpg" alt="Sunset on Koh Lanta beach"></picture><span class="cap">Sunset · Koh Lanta</span></div>
