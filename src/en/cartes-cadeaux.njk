{% block content %}{% raw %}
<section class="page-hero has-img" data-screen-label="Cartes cadeaux — hero">
  <div class="ph-bg"><img fetchpriority="high" sizes="(min-width: 900px) 50vw, 100vw" src="/images/girls/massage-plage.jpeg" alt="Traditional massage on the beach"></div>
  <div class="ph-overlay"></div>
  <div class="container">
    <h1>Give a Trip, Not Just a Destination</h1>
    <p>Birthday, wedding, Christmas, a group gift… Giving a trip means giving time, experiences and memories that never fade.</p>
  </div>
</section>

<section class="section-pad bg-cream pg-intro">
  <div class="container">
    <div class="pg-intro-head">
      <h2>Much more than just a card</h2>
      <p class="lead">A Zwald gift card is a complete travel service to give: I create a tailor-made itinerary for the person of your choice, based on their wishes, pace and budget. All they have to do is enjoy it.</p>
    </div>
    <div class="pg-list">
      <div class="pg-item"><h3>Tailor-made trip</h3><p>An itinerary created around the pace, wishes and budget of the person you're giving it to.</p></div>
      <div class="pg-item"><h3>Travel journal</h3><p>Flights, accommodation, day-by-day activities, local contacts, checklists and practical tips.</p></div>
      <div class="pg-item"><h3>Personal support</h3><p>Responsive support before and during the trip. Bookings remain the traveler's responsibility.</p></div>
    </div>
  </div>
</section>

<section class="section-pad pg-spec">
  <div class="container">
    <div class="pg-spec-photo"><img loading="lazy" decoding="async" sizes="(min-width: 900px) 40vw, 100vw" src="/images/girls/longtail.jpeg" alt="Long-tail boat fitted with cushions, ready to leave"></div>
    <div class="pg-spec-body">
      <div class="section-head">
      <h2>You choose everything</h2>
      </div>
      <div class="info-grid">
      <div class="info-card"><div class="k">Amount</div><div class="v">Choose your amount — <span class="price-chf" data-chf="50">50 CHF</span>, <span class="price-chf" data-chf="100">100 CHF</span> or <span class="price-chf" data-chf="200">200 CHF</span>… or more</div></div>
      <div class="info-card"><div class="k">Recipient</div><div class="v">The recipient's first name on the card</div></div>
      <div class="info-card"><div class="k">Destination</div><div class="v">Specific, or left open to discover</div></div>
      <div class="info-card"><div class="k">Occasion</div><div class="v">Christmas, birthday, wedding, farewell…</div></div>
      <div class="info-card"><div class="k">Message</div><div class="v">A personalized note included</div></div>
      <div class="info-card"><div class="k">Format</div><div class="v">PDF or image, ready to give</div></div>
    </div>
    <span class="currency-note" hidden>Indicative rate, updated daily — CHF remains the reference currency.</span>
    </div>
  </div>
</section>

<section class="section-pad cc-why">
  <div class="container">
    <div class="section-head">
      <h2>The gift that truly delights</h2>
    </div>
    <div class="cc-why-list">
      <div class="pg-item"><h3>Zero stress</h3><p>You're giving a fully organized trip: no hassle, just enjoyment.</p></div>
      <div class="pg-item"><h3>Real savings</h3><p>Thanks to my local rates, the recipient travels at fair prices, far from tourist traps.</p></div>
      <div class="pg-item"><h3>Lasting memories</h3><p>A gift that's experienced and retold long after — much more than an object.</p></div>
    </div>
  </div>
</section>

<section class="cta-band section-pad cta-full">
  <div class="ph-bg"><img sizes="(max-width: 899px) 150vw, 100vw" loading="lazy" decoding="async" src="/images/lac-longtail.jpg" alt="Turquoise water below the mountains, seen from a long-tail boat"></div>
  <div class="ph-overlay"></div>
  <div class="container">
    <h2>Order Your Gift Card</h2>
    <p>Tell me the occasion, the amount and who it's for — I'll prepare a personalized card, ready to give.</p>
    <div class="btns">
      <a class="btn btn-white btn-lg" href="/en/contact/" data-magnetic><span>Order my gift card <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
    </div>
  </div>
</section>
