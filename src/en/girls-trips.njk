{% block scripts %}{% raw %}
<script>
  ZWALD.init({ page: "girls" });
  (function () {
    var btn = document.getElementById("brochure-share");
    if (!btn) return;
    var url = location.origin + "/files/girls-trips-brochure.pdf";
    var label = btn.querySelector("span");
    var defaultLabel = label.innerHTML;
    btn.addEventListener("click", function () {
      if (navigator.share) {
        navigator.share({ title: "Girls Trips in Thailand — Zwald Travel Planner", text: "The brochure for my next Girls Trip in Thailand:", url: url }).catch(function () {});
        return;
      }
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(function () {
          label.textContent = "Link copied!";
          setTimeout(function () { label.innerHTML = defaultLabel; }, 2000);
        });
      }
    });
  })();
</script>
{% endraw %}{% endblock %}
