---
pagination:
  data: secretPages.pages
  size: 1
  alias: p
permalink: "/secret/{{ p.id }}/"
eleventyExcludeFromCollections: true
---
{#- Une page par excursion ou activité de Secret Travel & Tour (option A du chantier SEO, 30.10.2026).
    Même identité que /secret/ (affiche, polaroïds, vert et jaune), hors base.njk.
    Textes et programmes : _data/secretPagesContent.json, faits de la base partenaires. Aucun prix.
    Le bouton « Get a price » renvoie au formulaire de /secret/ avec l'excursion présélectionnée. -#}
{%- set wa = "https://wa.me/" + secret.contact.whatsapp -%}
{%- set hello = "Hi Secret Travel & Tour! I am interested in " + p.name + "." -%}
{%- set formHref = "/secret/?" + ("tour" if p.kind == "boat" else "activity") + "=" + (p.name | urlencode) + "#tell-us" -%}
<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>document.documentElement.className = "js";</script>
<title>{{ p.title }}</title>
<meta name="description" content="{{ p.metaDescription }}">
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="canonical" href="{{ p.url }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ p.url }}">
<meta property="og:title" content="{{ p.title }}">
<meta property="og:description" content="{{ p.metaDescription }}">
<meta property="og:image" content="https://zwaldtravelplanner.com/images/secret/{{ p.photo if p.photo else 'og-secret.jpg' }}">
<meta property="og:image:alt" content="{{ p.photoAlt if p.photo else 'Secret Travel & Tour, Koh Lanta' }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" sizes="32x32" href="/images/secret/icon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/images/secret/apple-touch-icon.png">
<meta name="theme-color" content="#0A4C44">
<link rel="preload" as="font" type="font/woff2" href="/css/fonts/concert-one-400-normal-latin.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/css/fonts/open-sans-variable-normal-latin.woff2" crossorigin>
<link rel="stylesheet" href="/css/secret.css">
{%- for block in p.jsonLd %}
<script type="application/ld+json">{{ block | dump | safe }}</script>
{%- endfor %}
</head>
<body class="page">
<div class="wrap">
  <header class="top">
    <a class="brand" href="/secret/">
      <img eleventy:ignore src="/images/secret/emblem.webp" width="240" height="198" alt="">
      <span>
        <span class="brand-name">SECRET TRAVEL &amp; TOUR</span>
        <span class="brand-place">KOH LANTA</span>
      </span>
    </a>
    <a class="back" href="/secret/#{{ 'boat-tours' if p.kind == 'boat' else 'on-the-island' }}">All {{ 'boat tours' if p.kind == 'boat' else 'activities' }}</a>
  </header>

  <section class="hero page-hero">
    <div class="hero-text">
      <p class="crumb"><a href="/secret/">Secret Travel &amp; Tour</a> · {{ 'Boat tours' if p.kind == 'boat' else 'On the island' }}</p>
      <h1>{{ p.h1 }} <em>{{ p.h1em }}</em></h1>
      <p class="lead">{{ p.lead }}</p>
      {%- if p.info.length %}<p class="facts">{{ p.info | join(" · ") }}</p>{% endif %}
      <div class="cta">
        <a class="btn" href="{{ formHref }}">Get a price</a>
        <a class="more" href="{{ wa }}?text={{ hello | urlencode }}">Ask on WhatsApp</a>
      </div>
    </div>
    {%- if p.photo %}
    <figure class="pol page-pol">
      <img eleventy:ignore src="/images/secret/{{ p.photo }}" alt="{{ p.photoAlt }}" width="900" height="600" fetchpriority="high"{% if p.photoPosition %} style="object-position:{{ p.photoPosition }}"{% endif %}>
    </figure>
    {%- endif %}
  </section>
</div>

<main>
  <div class="wrap">
    <section class="sec intro" aria-label="About this trip">
      {%- for para in p.intro %}
      <p>{{ para }}</p>
      {%- endfor %}
    </section>
  </div>

  <div class="band">
    <div class="wrap">
      <section class="sec" aria-labelledby="h-day">
        <div class="brush"><h2 id="h-day">{{ p.dayTitle | upper }}</h2></div>
        <ol class="day">
          {%- for step in p.day %}
          <li>{{ step }}</li>
          {%- endfor %}
        </ol>
      </section>

      <section class="sec cols" aria-labelledby="h-incl">
        <div>
          <div class="brush"><h2 id="h-incl">INCLUDED</h2></div>
          <ul class="ticks">
            {%- for item in p.included %}
            <li>{{ item }}</li>
            {%- endfor %}
          </ul>
        </div>
        {%- if p.notIncluded.length %}
        <div>
          <div class="brush"><h2>NOT INCLUDED</h2></div>
          <ul class="ticks no">
            {%- for item in p.notIncluded %}
            <li>{{ item }}{% if p.parkFee %}: {{ p.parkFee }}{% endif %}</li>
            {%- endfor %}
          </ul>
          <p class="park">{{ secretPages.parkFeeNote }}</p>
        </div>
        {%- endif %}
      </section>

      <section class="sec" aria-labelledby="h-know">
        <div class="brush"><h2 id="h-know">GOOD TO KNOW</h2></div>
        <ul class="know">
          {%- for item in p.goodToKnow %}
          <li>{{ item }}</li>
          {%- endfor %}
        </ul>
        <a class="get" href="{{ formHref }}">Get a price<span class="sr"> for {{ p.name }}</span></a>
      </section>
    </div>
  </div>

  <div class="wrap">
    <section class="sec faq-sec" aria-labelledby="h-faq">
      <h2 id="h-faq">Questions we get about this trip</h2>
      <div class="q-list">
      {%- for f in p.faq %}
      <details class="q">
        <summary>{{ f.q }}</summary>
        <p>{{ f.a }}</p>
      </details>
      {%- endfor %}
      </div>
    </section>

    <section class="sec others" aria-labelledby="h-others">
      <h2 id="h-others">Other {{ 'boat tours' if p.kind == 'boat' else 'things to do on the island' }}</h2>
      <div>
      <ul>
        {%- for o in secretPages.pages %}{% if o.kind == p.kind and o.id != p.id %}
        <li><a href="/secret/{{ o.id }}/">{{ o.name }}</a>{% if o.info.length %} <span>{{ o.info | join(" · ") }}</span>{% endif %}</li>
        {%- endif %}{% endfor %}
      </ul>
      <p><a class="more" href="/secret/">Everything we organise on Koh Lanta</a></p>
      </div>
    </section>

    <section class="find" aria-labelledby="h-find">
      <h2 id="h-find">Find us</h2>
      <p>{{ secret.business.addressDisplay }}</p>
      <a class="maps" href="{{ secret.business.googleMaps }}">Open in Google Maps</a>
    </section>
  </div>
</main>

<aside class="zwald" aria-labelledby="h-zwald">
  <div class="wrap">
    <h2 id="h-zwald">Need a taxi or a minivan?</h2>
    <p>Airport transfers and private rides across Southern Thailand are driven by VIP Taxi Lanta, our partner based on Koh Lanta.</p>
    <a href="/taxi/">See VIP Taxi Lanta</a>
  </div>
</aside>

<footer class="foot">
  <div class="wrap">
    <p class="foot-name">{{ secret.business.name }}</p>
    <p>{{ secret.business.addressDisplay }} · <a href="{{ secret.business.googleMaps }}">Google Maps</a></p>
    <p>WhatsApp <a href="{{ wa }}?text={{ hello | urlencode }}">{{ secret.business.phoneDisplay }}</a></p>
    <p class="foot-legal">{{ secret.business.name }} is operated by {{ secret.business.operator }}. <a href="/cgv/">Terms</a> · <a href="/mentions-legales/">Legal notice</a></p>
  </div>
</footer>
</body>
</html>
