{% block content %}{% raw %}
<section class="page-hero gl-hero" data-screen-label="Galerie — hero">
  <div class="container">
    <h1>La Thaïlande, en images</h1>
    <p>Temples, îles, marchés et points de vue, photographiés en chemin. Un avant-goût de ce qui t'attend.</p>
  </div>
</section>

<section class="section-pad gl-main">
  <div class="container">
    <div class="gallery">
      <div class="g-item" data-lightbox data-src="/images/galerie/railay-eau-claire.jpg"><img sizes="(min-width: 700px) 66vw, 100vw" fetchpriority="high" src="/images/galerie/railay-eau-claire.jpg" alt="Eau transparente au pied d'une falaise"></div>
      <div class="g-item" data-lightbox data-src="/images/IMG_6422.jpg"><img sizes="(min-width: 700px) 33vw, 50vw" loading="lazy" decoding="async" src="/images/IMG_6422.jpg" alt="Îles et lagons vus d'en haut"></div>
      <div class="g-item" data-lightbox data-src="/images/galerie/phang-nga.jpg"><img sizes="(min-width: 700px) 33vw, 50vw" loading="lazy" decoding="async" src="/images/galerie/phang-nga.jpg" alt="Point de vue sur une baie et ses pitons"></div>
      <div class="g-item" data-lightbox data-src="/images/galerie/bangkok-chinatown.jpg"><img sizes="(min-width: 700px) 66vw, 100vw" loading="lazy" decoding="async" src="/images/galerie/bangkok-chinatown.jpg" alt="Bangkok la nuit, enseignes de Chinatown"></div>
      <div class="g-item" data-lightbox data-src="/images/galerie/bangkok-rooftop.jpg"><img sizes="(min-width: 700px) 33vw, 50vw" loading="lazy" decoding="async" src="/images/galerie/bangkok-rooftop.jpg" alt="Bangkok et le fleuve depuis un rooftop"></div>
      <div class="g-item" data-lightbox data-src="/images/IMG_5227.jpg"><img sizes="(min-width: 700px) 33vw, 50vw" loading="lazy" decoding="async" src="/images/IMG_5227.jpg" alt="Anaïs devant un chedi doré"></div>
      <div class="g-item" data-lightbox data-src="/images/galerie/elephants-cafe.jpg"><img sizes="(min-width: 700px) 66vw, 100vw" loading="lazy" decoding="async" src="/images/galerie/elephants-cafe.jpg" alt="Éléphants vus depuis une terrasse"></div>
      <div class="g-item" data-lightbox data-src="/images/IMG_9507.jpg"><img sizes="(min-width: 700px) 33vw, 50vw" loading="lazy" decoding="async" src="/images/IMG_9507.jpg" alt="Cascade dans la forêt"></div>
      <div class="g-item" data-lightbox data-src="/images/IMG_5519.jpg"><img sizes="(min-width: 700px) 33vw, 50vw" loading="lazy" decoding="async" src="/images/IMG_5519.jpg" alt="Kayak dans la mangrove"></div>
      <div class="g-item" data-lightbox data-src="/images/IMG_6793.jpg"><img sizes="(min-width: 700px) 66vw, 100vw" loading="lazy" decoding="async" src="/images/IMG_6793.jpg" alt="Baignade entre les rochers"></div>
      <div class="g-item" data-lightbox data-src="/images/IMG_3258.jpg"><img sizes="(min-width: 700px) 33vw, 50vw" loading="lazy" decoding="async" src="/images/IMG_3258.jpg" alt="Allée de cocotiers"></div>
