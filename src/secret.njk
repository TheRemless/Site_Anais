---
permalink: /secret/
eleventyExcludeFromCollections: true
---
{#- Site officiel de Secret Travel & Tour (Koh Lanta) : lien de la fiche Google Maps et cible du QR code de l'affiche.
    Volontairement hors de base.njk : identité de l'affiche, sans header, footer ni bannière Zwald.
    Tout le catalogue vient de _data/secret.json ; secretView calcule la carte et la liste des infos à confirmer.
    Le numéro WhatsApp est partagé avec Zwald : chaque message commence par « Hi Secret Travel & Tour! ». -#}
{%- set wa = "https://wa.me/" + secret.contact.whatsapp -%}
{%- set hello = "Hi Secret Travel & Tour!" -%}
{%- macro pol(photo, alt, position, extraClass) -%}
<figure class="pol {{ extraClass }}{% if not photo %} pol-empty{% endif %}">
  {%- if photo %}<img src="/images/secret/{{ photo }}" alt="{{ alt }}" loading="lazy" width="900" height="600"{% if position %} style="object-position:{{ position }}"{% endif %}>
  {%- else %}<span>photo to come</span>{% endif -%}
</figure>
{%- endmacro -%}
{%- macro getPrice(type, value) -%}
<a class="get" href="#tell-us" data-type="{{ type }}" data-value="{{ value }}">Get a price<span class="sr"> for {{ value }}</span></a>
{%- endmacro -%}
{%- macro card(item, type) -%}
<article class="card">
  {{ pol(item.photo, item.photoAlt, item.photoPosition, "") }}
  <h3>{{ item.name }}</h3>
  <p>{{ item.description }}</p>
  {%- if item.info.length %}<p class="info">{{ item.info | join(" · ") }}</p>{% endif %}
  {{ getPrice(type, item.name) }}
</article>
{%- endmacro -%}
{%- macro waIcon(size) -%}
<svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm0 1.8a8.2 8.2 0 016.9 12.6l-.2.3.8 2.9-3-.8-.3.2A8.2 8.2 0 1112 3.8zm-1.2 4.5c-.2-.4-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.8.8-.8 1.9s.8 2.2.9 2.4c.1.1 1.6 2.5 3.9 3.4.5.2.9.3 1.2.4.5.1 1 .1 1.4 0 .4-.1 1.3-.5 1.5-1s.2-1 .1-1.1c0-.1-.2-.2-.4-.3s-1.3-.6-1.5-.7c-.2-.1-.3-.1-.5.1-.1.2-.5.7-.7.8-.1.2-.3.2-.5.1-.2-.1-.9-.3-1.7-1-.6-.5-1-1.2-1.1-1.4-.1-.2 0-.3.1-.4l.4-.4c.1-.1.2-.3.2-.4.1-.1 0-.3 0-.4z"/></svg>
{%- endmacro -%}
{%- macro stepper(name, label, value, min, ages) -%}
<div class="field">
  <label for="f-{{ name }}">{{ label }}{% if ages %} <span class="ages">{{ ages }}</span>{% endif %}</label>
  <div class="step">
    <button type="button" data-step="-1" aria-label="One less">&minus;</button>
    <input id="f-{{ name }}" name="{{ name }}" type="number" inputmode="numeric" min="{{ min }}" max="60" value="{{ value }}">
    <button type="button" data-step="1" aria-label="One more">+</button>
  </div>
</div>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>document.documentElement.className = "js";</script>
<title>Secret Travel &amp; Tour | Transfers, Boat Tours &amp; Activities in Koh Lanta</title>
<meta name="description" content="Travel agency in Koh Lanta. Minivan transfers, boat tours and island activities. Tell us what you need and get a price on WhatsApp.">
<link rel="canonical" href="https://zwaldtravelplanner.com/secret/">
<meta property="og:type" content="website">
<meta property="og:url" content="https://zwaldtravelplanner.com/secret/">
<meta property="og:title" content="Secret Travel &amp; Tour | Transfers, Boat Tours &amp; Activities in Koh Lanta">
<meta property="og:description" content="Travel agency in Koh Lanta. Minivan transfers, boat tours and island activities. Get a price on WhatsApp.">
<meta property="og:image" content="https://zwaldtravelplanner.com/images/secret/og-secret.jpg?v=2">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Secret Travel &amp; Tour, Koh Lanta">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" sizes="32x32" href="/images/secret/icon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/images/secret/apple-touch-icon.png">
<meta name="theme-color" content="#0A4C44">
<link rel="preload" as="font" type="font/woff2" href="/css/fonts/concert-one-400-normal-latin.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/css/fonts/open-sans-variable-normal-latin.woff2" crossorigin>
<link rel="stylesheet" href="/css/secret.css">
<script type="application/ld+json">{{ secretView.jsonLd | dump | safe }}</script>
</head>
<body>
{%- if secretView.showDraftBanner %}
<details class="draft">
  <summary>Preview: {{ secretView.toConfirm.length }} details still to confirm with the team</summary>
  <ul>{% for item in secretView.toConfirm %}<li>{{ item }}</li>{% endfor %}</ul>
</details>
{%- endif %}
<div class="wrap">
  <header class="top">
    <a class="brand" href="/secret/">
      <img src="/images/secret/emblem.webp" width="240" height="198" alt="">
      <span>
        <span class="brand-name">SECRET TRAVEL &amp; TOUR</span>
        <span class="brand-place">KOH LANTA</span>
      </span>
    </a>
  </header>

  <section class="hero" id="hero">
    <div class="hero-text">
      <h1>Your travel agency <em>in Koh Lanta</em></h1>
      <p class="lead">Transfers, boat tours and island activities, booked with a local team.</p>
      <div class="cta">
        <a class="btn" href="#tell-us" data-open-form>{{ waIcon(20) }}Get a price</a>
        <a class="more" href="#what-we-do">See what we do</a>
      </div>
      <p class="facts">{{ secret.business.hours.display }}{% if secret.licence %}. Licensed travel agency, TAT no. {{ secret.licence }}{% endif %}.</p>
    </div>
    <img class="hero-photo" src="/images/secret/longtail.webp" width="900" height="1600" alt="Our longtail boat on clear turquoise water">
  </section>
</div>

<main>
  <div class="band" id="what-we-do">
    <div class="wrap">
      <section class="sec" aria-labelledby="h-transfers">
        <div class="brush"><h2 id="h-transfers">TRANSFERS</h2><p>by minivan, private &amp; shared</p></div>
        <p class="transfer-text">Hotel to hotel, airports, piers and ferries. Krabi, Phuket, Ao Nang, Khao Sok, Surat Thani, Trang and more.</p>
        <a class="get" href="#tell-us" data-type="transfer" data-value="">Get a price<span class="sr"> for a transfer</span></a>
      </section>

      <section class="sec" id="boat-tours" aria-labelledby="h-boats">
        <div class="brush"><h2 id="h-boats">BOAT TOURS</h2><p>private &amp; join-in trips</p></div>
        <div class="rail">{% for t in secret.tours %}{{ card(t, "boat") }}{% endfor %}</div>
      </section>

      <section class="sec" id="on-the-island" aria-labelledby="h-island">
        <div class="brush"><h2 id="h-island">ON THE ISLAND</h2></div>
        <div class="rail">{% for a in secret.activities %}{{ card(a, "activity") }}{% endfor %}</div>
      </section>

      <p class="else"><b>Something else in mind?</b> <a href="{{ wa }}?text={{ hello | urlencode }}">Ask us</a>, we organise a bit of everything on Koh Lanta.</p>
    </div>
  </div>

  <div class="wrap">
    <section class="ask-sec" id="tell-us" aria-labelledby="h-ask">
      <div>
        <h2 id="h-ask">Tell us what you need</h2>
        <p>Pick a transfer, a boat tour or an activity. Your message is ready to send on WhatsApp and we reply with a price.</p>
      </div>
    <div class="ask-slot" id="ask-slot">
      <a class="btn nojs-cta" href="{{ wa }}?text={{ hello | urlencode }}">Message us on WhatsApp</a>

      <form class="ask" id="ask" novalidate aria-labelledby="ask-title">
        <div class="ask-head">
          <h2 id="ask-title">What do you need?</h2>
          <button type="button" class="clear" id="clear-form">Clear form</button>
        </div>

        <fieldset class="seg seg-3">
          <legend class="sr">Type of request</legend>
          <label><input type="radio" name="type" value="transfer" checked><span>Transfer</span></label>
          <label><input type="radio" name="type" value="boat"><span>Boat tour</span></label>
          <label><input type="radio" name="type" value="activity"><span>Activity</span></label>
        </fieldset>

        <fieldset class="group" data-for="transfer">
          <legend class="sr">Transfer</legend>
          <div class="field">
            <label for="f-t-from">From</label>
            <input id="f-t-from" name="t-from" type="text" list="places" autocomplete="off" aria-describedby="hint-from err-from">
            <p class="hint" id="hint-from">Your hotel, an airport, a pier, a town…</p>
            <p class="err" id="err-from" hidden></p>
          </div>
          <div class="field">
            <label for="f-t-to">To</label>
            <input id="f-t-to" name="t-to" type="text" list="places" autocomplete="off" aria-describedby="err-to">
            <p class="err" id="err-to" hidden></p>
          </div>
          <datalist id="places">
            {%- for place in secret.places %}<option value="{{ place }}">{% endfor %}
          </datalist>
        </fieldset>

        <fieldset class="group" data-for="boat" hidden disabled>
          <legend class="sr">Boat tour</legend>
          <div class="field">
            <label for="f-b-tour">Boat tour</label>
            <select id="f-b-tour" name="b-tour" aria-describedby="err-tour">
              <option value="">Choose</option>
              {%- for t in secret.tours %}<option>{{ t.name }}</option>{% endfor %}
            </select>
            <p class="err" id="err-tour" hidden></p>
          </div>
        </fieldset>

        <fieldset class="group" data-for="activity" hidden disabled>
          <legend class="sr">Activity</legend>
          <div class="field">
            <label for="f-a-activity">Activity</label>
            <select id="f-a-activity" name="a-activity" aria-describedby="err-activity">
              <option value="">Choose</option>
              {%- for a in secret.activities %}<option>{{ a.name }}</option>{% endfor %}
            </select>
            <p class="err" id="err-activity" hidden></p>
          </div>
        </fieldset>

        <fieldset class="field date" aria-describedby="err-date">
          <legend>Date</legend>
          <div class="seg seg-3">
            <label><input type="radio" name="dateChoice" value="today"><span>Today</span></label>
            <label><input type="radio" name="dateChoice" value="tomorrow"><span>Tomorrow</span></label>
            <label><input type="radio" name="dateChoice" value="other"><span>Other date</span></label>
          </div>
          <div class="date-other" data-show-when="other-date">
            <label class="sr" for="f-dateOther">Choose a date</label>
            <input id="f-dateOther" name="dateOther" type="date">
          </div>
          <p class="err" id="err-date" hidden></p>
        </fieldset>

        <fieldset class="group" data-for="transfer">
          <legend class="sr">Transfer details</legend>
          <div class="field">
            <label for="f-t-time">Pickup time or flight time</label>
            <input id="f-t-time" name="t-time" type="time">
          </div>
          <div class="row row-3">
            {{ stepper("t-adults", "Adults", 2, 1, "12+") }}
            {{ stepper("t-children", "Children", 0, 0, "3-11") }}
            {{ stepper("t-babies", "Babies", 0, 0, "0-2") }}
          </div>
          <p class="err" id="err-adults" hidden></p>
          <div class="seats">
            <label class="check" data-show-when="children"><input type="checkbox" name="t-childSeat"><span>We need a child seat</span></label>
            <label class="check" data-show-when="babies"><input type="checkbox" name="t-babySeat"><span>We need a baby seat</span></label>
          </div>
          <fieldset class="field">
              <legend>Minivan</legend>
              <div class="seg">
                <label><input type="radio" name="t-mode" value="private" checked><span>Private</span></label>
                <label><input type="radio" name="t-mode" value="shared"><span>Shared</span></label>
              </div>
          </fieldset>
        </fieldset>

        <fieldset class="group" data-for="boat" hidden disabled>
          <legend class="sr">Boat tour details</legend>
          <div class="row row-3">
            {{ stepper("b-adults", "Adults", 2, 1, "12+") }}
            {{ stepper("b-children", "Children", 0, 0, "3-11") }}
            {{ stepper("b-babies", "Babies", 0, 0, "0-2") }}
          </div>
          <p class="err" id="err-adults-boat" hidden></p>
          <fieldset class="field">
            <legend>Boat</legend>
            <div class="seg">
              <label><input type="radio" name="b-mode" value="private" checked><span>Private</span></label>
              <label><input type="radio" name="b-mode" value="join-in"><span>Join-in</span></label>
            </div>
          </fieldset>
        </fieldset>

        <fieldset class="group" data-for="activity" hidden disabled>
          <legend class="sr">Activity details</legend>
          {{ stepper("a-people", "People", 2, 1) }}
        </fieldset>

        <div class="field" id="hotel-field">
          <label for="f-hotel">Hotel or accommodation</label>
          <input id="f-hotel" name="hotel" type="text" autocomplete="off" aria-describedby="hint-hotel">
          <p class="hint" id="hint-hotel">Where we pick you up</p>
        </div>

        <button class="btn send" type="submit">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm0 1.8a8.2 8.2 0 016.9 12.6l-.2.3.8 2.9-3-.8-.3.2A8.2 8.2 0 1112 3.8zm-1.2 4.5c-.2-.4-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.8.8-.8 1.9s.8 2.2.9 2.4c.1.1 1.6 2.5 3.9 3.4.5.2.9.3 1.2.4.5.1 1 .1 1.4 0 .4-.1 1.3-.5 1.5-1s.2-1 .1-1.1c0-.1-.2-.2-.4-.3s-1.3-.6-1.5-.7c-.2-.1-.3-.1-.5.1-.1.2-.5.7-.7.8-.1.2-.3.2-.5.1-.2-.1-.9-.3-1.7-1-.6-.5-1-1.2-1.1-1.4-.1-.2 0-.3.1-.4l.4-.4c.1-.1.2-.3.2-.4.1-.1 0-.3 0-.4z"/></svg>
          Send on WhatsApp
        </button>
        <p class="note">Opens WhatsApp with your message ready. Your details stay on your phone until you send.</p>
      </form>
    </div>
    </section>

    {%- if secret.team.text and secret.team.photo %}
    <section class="who" aria-labelledby="h-who">
      <div><h2 id="h-who">Who we are</h2><p>{{ secret.team.text }}</p></div>
      <figure class="pol"><img src="/images/secret/{{ secret.team.photo }}" alt="The Secret Travel &amp; Tour team" loading="lazy" width="900" height="600"></figure>
    </section>
    {%- endif %}

    <section class="find" aria-labelledby="h-find">
      <h2 id="h-find">Find us</h2>
      <p>{{ secret.business.addressDisplay }}</p>
      <p>{{ secret.business.hours.display }}</p>
      <a class="maps" href="{{ secret.business.googleMaps }}"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 005 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>Open in Google Maps</a>
    </section>
  </div>
</main>

<aside class="zwald" aria-labelledby="h-zwald">
  <div class="wrap">
    <h2 id="h-zwald">Planning a bigger trip?</h2>
    <p>Zwald Travel Planner, the team behind Secret Travel &amp; Tour, designs tailor-made trips across Thailand and Southeast Asia.</p>
    <a href="/en/">Discover Zwald Travel Planner</a>
  </div>
</aside>

<footer class="foot">
  <div class="wrap">
    <p class="foot-name">{{ secret.business.name }}</p>
    <p>{{ secret.business.addressDisplay }} · <a href="{{ secret.business.googleMaps }}">Google Maps</a></p>
    <p>{{ secret.business.hours.display }} · WhatsApp <a href="{{ wa }}?text={{ hello | urlencode }}">{{ secret.business.phoneDisplay }}</a></p>
    <p class="foot-legal">{{ secret.business.name }} is operated by {{ secret.business.operator }}{% if secret.licence %}, licensed travel agency (TAT licence no. {{ secret.licence }}).{% endif %} <a href="/cgv/">Terms</a> · <a href="/mentions-legales/">Legal notice</a></p>
  </div>
</footer>



<script src="/js/secret-form.js"></script>
<script src="/js/secret.js"></script>
</body>
</html>
