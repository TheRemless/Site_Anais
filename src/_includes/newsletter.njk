<section class="section-pad bg-cream nl-band" id="newsletter">
  <div class="container narrow text-center" data-reveal>
    <h2>{{ 'newsletter.title' | t(lang) }}</h2>
    <p class="mt-s" style="color:var(--ink-mute);max-width:52ch;margin-inline:auto">{{ 'newsletter.intro' | t(lang) }}</p>
    <div class="mt-l nl-compact">
      <form class="nl-form" name="newsletter" method="POST" action="{{ page.url }}#newsletter-merci" data-netlify="true" netlify-honeypot="bot-field" data-sending="{{ 'newsletter.sending' | t(lang) }}">
        <input type="hidden" name="form-name" value="newsletter">
        <input type="hidden" name="lang" value="{{ lang }}">
        <p class="nl-hp" aria-hidden="true"><label>{{ 'newsletter.honeypot' | t(lang) }} <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
        <div class="nl-fields">
          <div class="field"><label for="nl-prenom">{{ 'newsletter.firstName' | t(lang) }}</label><input type="text" id="nl-prenom" name="prenom" autocomplete="given-name" maxlength="80"></div>
          <div class="field"><label for="nl-email">{{ 'newsletter.email' | t(lang) }}</label><input type="email" id="nl-email" name="email" autocomplete="email" required></div>
          <button class="btn btn-teal" type="submit"><span>{{ 'newsletter.submit' | t(lang) }}</span></button>
        </div>
        <p class="nl-msg nl-error" role="alert" hidden>{{ 'newsletter.error' | t(lang) }}</p>
      </form>
      <p class="nl-msg nl-success" id="newsletter-merci" role="status" tabindex="-1">{{ 'newsletter.success' | t(lang) }}</p>
    </div>
  </div>
</section>
<script src="/js/newsletter.js?v={{ build.v }}"></script>
