{#- Newsletter : un champ e-mail envoyé par Netlify Forms (formulaire « newsletter »).
    Aucun script tiers, aucun cookie : le formulaire s'affiche pour tout le monde.
    Envoi en arrière-plan par site.js (initNewsletter) ; sans JavaScript, envoi classique
    puis retour sur la page. -#}
{%- set en = (lang == "en") %}
<section class="section-pad bg-cream nl-band" id="newsletter">
  <div class="container narrow text-center">
    <h2>{{ "Plan your trip with confidence" if en else "Prépare ton voyage avec confiance" }}</h2>
    <p class="mt-s" style="color:var(--ink-mute);max-width:52ch;margin-inline:auto">{{ "Tips, local addresses and travel advice straight to your inbox. No spam, promise." if en else "Conseils, adresses locales et astuces de voyage directement dans ta boîte mail. Aucun spam, promis." }}</p>
    <div class="mt-l nl-compact">
      <form class="nl-form" name="newsletter" method="POST" action="{{ page.url }}#newsletter" data-netlify="true" netlify-honeypot="bot-field" data-newsletter>
        <input type="hidden" name="form-name" value="newsletter">
        <input type="hidden" name="lang" value="{{ lang }}">
        <p hidden><label>{{ "Leave empty:" if en else "Ne pas remplir :" }} <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
        <label class="nl-label" for="nl-email">{{ "Your email" if en else "Ton e-mail" }}</label>
        <div class="nl-row">
          <input class="nl-input" id="nl-email" type="email" name="email" autocomplete="email" inputmode="email" required placeholder="{{ 'you@email.com' if en else 'ton@email.com' }}">
          <button class="btn btn-teal" type="submit"><span>{{ "Sign me up" if en else "Je m'inscris" }}</span></button>
        </div>
        <p class="nl-note">{{ "Details in the" if en else "Détails dans la" }} <a href="/politique-confidentialite/">{{ "privacy policy" if en else "politique de confidentialité" }}</a>.</p>
        <p class="nl-msg nl-ok" role="status" hidden>{{ "Thanks for signing up! See you soon in your inbox." if en else "Merci pour ton inscription ! À très vite dans ta boîte mail." }}</p>
        <p class="nl-msg nl-err" role="alert" hidden>{{ "The sign-up could not be saved. Please try again." if en else "L'inscription n'a pas pu être enregistrée. Réessaie dans un instant." }}</p>
      </form>
    </div>
  </div>
</section>
