<footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a class="brand" href="{{ '/en/' if lang == 'en' else '/' }}"><img loading="lazy" decoding="async" src="/images/logo.png" alt="" style="width:46px;height:46px;border-radius:50%"><span class="brand-text"><span class="brand-name">Zwald</span> <span class="brand-sub">Travel Planner</span></span></a>
          <p>{{ "footer.tagline" | t(lang) }}</p>
        </div>
        <div><h2>{{ "footer.explorer" | t(lang) }}</h2><ul>
        {%- for item in nav %}
          {%- set href = item.hrefEn if lang == "en" else item.hrefFr %}
          <li><a href="{{ href }}">{{ item.labelKey | t(lang) }}{% if lang == "en" and item.hrefEn == item.hrefFr %}{{ "footer.frOnly" | t(lang) }}{% endif %}</a></li>
        {%- endfor %}
          <li><a href="{{ '/en/contact/' if lang == 'en' else '/contact/' }}">{{ "nav.contact" | t(lang) }}</a></li>
        </ul></div>
        <div><h2>{{ "footer.services" | t(lang) }}</h2><ul>
          <li><a href="{{ '/en/services/' if lang == 'en' else '/services/' }}">{{ "footer.customTrips" | t(lang) }}</a></li>
          <li><a href="{{ '/en/girls-trips/' if lang == 'en' else '/girls-trips/' }}">{{ "nav.girlstrips" | t(lang) }}</a></li>
          <li><a href="{{ '/en/cartes-cadeaux/' if lang == 'en' else '/cartes-cadeaux/' }}">{{ "footer.giftcards" | t(lang) }}</a></li>
          <li><a href="/mini-guides/">{{ "footer.miniGuides" | t(lang) }}{% if lang == "en" %}{{ "footer.frOnly" | t(lang) }}{% endif %}</a></li>
        </ul></div>
        <div><h2>{{ "footer.contact" | t(lang) }}</h2><ul>
          <li><a href="https://wa.me/66958683846" target="_blank" rel="noopener">WhatsApp · +66 95 868 38 46</a></li>
          <li><a href="{{ '/en/contact/' if lang == 'en' else '/contact/' }}">{{ "footer.discoveryCall" | t(lang) }}</a></li>
        </ul>
        <div class="footer-social" style="margin-top:18px">
          <a href="https://www.instagram.com/zwaldtravelplanner/" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
          <a href="https://www.facebook.com/people/Zwald-Travel-Planner/61568573411432/" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3l.5-3H14V4.5c0-.9.3-1.5 1.6-1.5H17V.3C16.6.2 15.6 0 14.5 0 12 0 10.5 1.4 10.5 4.2V6H8v3h2.5v9H14V9z"/></svg></a>
          <a href="https://wa.me/66958683846" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm0 1.8a8.2 8.2 0 016.9 12.6l-.2.3.8 2.9-3-.8-.3.2A8.2 8.2 0 1112 3.8z"/></svg></a>
        </div>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© <span id="footer-year">2026</span> Zwald Travel Planner — {{ "footer.rights" | t(lang) }}</span>
        <span class="footer-legal"><a href="/mentions-legales/">{{ "footer.legalNotice" | t(lang) }}{% if lang == "en" %}{{ "footer.frOnly" | t(lang) }}{% endif %}</a> · <a href="{% if lang == "en" %}/en/cgv/{% else %}/cgv/{% endif %}">{{ "footer.cgv" | t(lang) }}</a> · <a href="/politique-confidentialite/">{{ "footer.privacy" | t(lang) }}{% if lang == "en" %}{{ "footer.frOnly" | t(lang) }}{% endif %}</a> · <a href="#" onclick="if(window.ZW_openConsent){ZW_openConsent();}return false;">{{ "footer.cookies" | t(lang) }}</a></span>
      </div>
    </div>
  </footer>
