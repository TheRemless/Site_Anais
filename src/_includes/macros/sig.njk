{# Signature « carnet de voyage » : dessins réutilisables. Styles et mode d'emploi dans system.css (bloc « Signature »). #}

{# Trajet en pointillés de .sig-route (bureau) : un tronçon par étape, du centre d'un disque au suivant, le dernier finit sur l'avion.
   n = nombre d'étapes, le même que --sig-n. #}
{% macro routeLine(n=4) %}<div class="sig-route-line" aria-hidden="true">{% for i in range(1, n + 1) %}{% if i < n %}<svg viewBox="0 0 100 40" preserveAspectRatio="none" focusable="false"><path d="{{ 'M0 20 C 30 -6, 70 46, 100 20' if i % 2 else 'M0 20 C 30 46, 70 -6, 100 20' }}"/></svg>{% else %}<svg viewBox="0 0 100 40" preserveAspectRatio="none" focusable="false"><path d="M0 20 C 25 4, 50 36, 66 16 S 80 2, 84 14 S 90 34, 95 22 S 98 16, 100 18"/></svg>{% endif %}{% endfor %}</div>{% endmacro %}

{# Petit avion du carnet (pointe vers la droite) #}
{% macro plane(cls="sig-plane") %}<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" transform="rotate(90 12 12)" d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>{% endmacro %}

{# Repère de lieu (départ ou arrivée d'un trajet) #}
{% macro pin(cls="sig-pin") %}<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M12 21s-6-5.6-6-10.4A6 6 0 0 1 18 10.6C18 15.4 12 21 12 21z"/><circle cx="12" cy="10.5" r="2.2" fill="currentColor"/><path fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" d="M8.5 22.5h7"/></svg>{% endmacro %}
