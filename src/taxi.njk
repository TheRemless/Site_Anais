---
permalink: /taxi/
eleventyExcludeFromCollections: true
---
{#- Page autonome de VIP Taxi Lanta (Mr. Brown), prestataire de transferts à Koh Lanta.
    Volontairement hors de base.njk, comme /secret/ : identité du prestataire, sans header,
    footer, bannière cookies ni Google Analytics. Formulaire Netlify Forms (name="taxi"),
    pas d'autre canal de contact. L'auto-réponse Zwald ne s'applique pas à ce formulaire
    (voir netlify/functions/submission-created.js). -#}
{% macro field(name, label, type, attrs, help) %}
<div class="field">
  <label for="f-{{ name }}">{{ label }}</label>
  {% if help %}<p class="help" id="h-{{ name }}">{{ help }}</p>{% endif %}
  <input id="f-{{ name }}" name="{{ name }}" type="{{ type }}" {{ attrs | safe }} required aria-describedby="{% if help %}h-{{ name }} {% endif %}e-{{ name }}">
  <p class="err" id="e-{{ name }}" hidden></p>
</div>
{% endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VIP Taxi Lanta | Private taxi &amp; minivan in Koh Lanta</title>
<meta name="description" content="Private taxi, minivan and airport transfers from Koh Lanta to Krabi, Phuket, Surat Thani and across Southern Thailand. Send a request and the team confirms on WhatsApp.">
<meta name="robots" content="noindex, follow">
<link rel="canonical" href="https://zwaldtravelplanner.com/taxi/">
<meta property="og:type" content="website">
<meta property="og:url" content="https://zwaldtravelplanner.com/taxi/">
<meta property="og:title" content="VIP Taxi Lanta | Private taxi &amp; minivan in Koh Lanta">
<meta property="og:description" content="Private transfers from Koh Lanta to airports, piers and cities across Southern Thailand.">
<meta property="og:image" content="https://zwaldtravelplanner.com/images/taxi/og-taxi.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="VIP Taxi Lanta, Mr. Brown, private taxis and minivans">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" sizes="32x32" href="/images/taxi/icon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/images/taxi/apple-touch-icon.png">
<meta name="theme-color" content="#F2E8CF">
<link rel="preload" as="font" type="font/woff2" href="/css/fonts/cormorant-garamond-700-normal-latin.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/css/fonts/manrope-400-normal-latin.woff2" crossorigin>
<link rel="stylesheet" href="/css/fonts.css">
<link rel="stylesheet" href="/css/taxi.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

{% if taxiView.showDraftBanner %}
<aside class="draft" role="note">
  <p><strong>Preview only.</strong> Not confirmed by VIP Taxi Lanta yet:</p>
  <ul>{% for item in taxiView.toConfirm %}<li>{{ item }}</li>{% endfor %}</ul>
</aside>
{% endif %}

<header class="hero">
  <div class="wrap">
    <img class="logo" src="/images/taxi/logo.webp" width="640" height="640" alt="VIP Taxi Lanta, Mr. Brown, private taxis &amp; minivans">
    <h1>{{ taxi.hero.title }}</h1>
    <p class="lead">{{ taxi.hero.lead }}</p>
    <p class="note">{{ taxi.hero.note }}</p>
    <a class="btn" href="#request">Request a transfer</a>
    {% if taxi.hero.photo %}
    <img class="hero-photo" src="{{ taxi.hero.photo.src }}" width="{{ taxi.hero.photo.width }}" height="{{ taxi.hero.photo.height }}" alt="{{ taxi.hero.photo.alt }}">
    {% elif taxiView.showDraftBanner %}
    <div class="photo-todo">Photo to come: our vehicle</div>
    {% endif %}
  </div>
</header>

<main id="main">
  <section class="sec" aria-labelledby="h-services">
    <div class="wrap">
      <h2 id="h-services">What we do</h2>
      <ul>
        {% for s in taxi.services %}
        <li class="svc">
          <h3>{{ s.title }}</h3>
          <p>{{ s.text }}</p>
          {% if s.link %}<a class="svc-link" href="{{ s.link.href }}">{{ s.link.label }}</a>{% endif %}
          {% if s.photo %}<img src="{{ s.photo.src }}" width="{{ s.photo.width }}" height="{{ s.photo.height }}" alt="{{ s.photo.alt }}" loading="lazy">{% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="h-gallery">
    <div class="wrap">
      <h2 id="h-gallery">{{ taxi.gallery.title }}</h2>
      <div class="gallery">
        {% for p in taxi.gallery.photos %}
        <img src="{{ p.src }}" width="{{ p.width }}" height="{{ p.height }}" alt="{{ p.alt }}" loading="lazy">
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="h-why">
    <div class="wrap">
      <h2 id="h-why">Why VIP Taxi Lanta</h2>
      <ul class="why">
        {% for w in taxi.why %}
        <li><h3>{{ w.title }}</h3><p>{{ w.text }}</p></li>
        {% endfor %}
      </ul>
      <p class="rating"><a href="{{ taxi.business.reviewsUrl }}" rel="noopener">{{ taxi.rating.text }}</a></p>
    </div>
  </section>

  <section class="sec" aria-labelledby="h-how">
    <div class="wrap">
      <h2 id="h-how">How it works</h2>
      <ol class="steps">
        {% for st in taxi.steps %}
        <li><div><h3>{{ st.title }}</h3><p>{{ st.text }}</p></div></li>
        {% endfor %}
      </ol>
      <p class="pay">{{ taxi.payment.text }}</p>
    </div>
  </section>

  <section class="form-sec" id="request" aria-labelledby="h-request">
    <div class="wrap">
      <h2 id="h-request">Request a transfer</h2>
      <form id="taxi-form" name="taxi" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate>
        <input type="hidden" name="form-name" value="taxi">
        <p class="hp" aria-hidden="true"><label>Do not fill this in: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>

        {{ field("name", "Name", "text", 'autocomplete="name"') }}
        {{ field("phone", "Phone (WhatsApp)", "tel", 'autocomplete="tel" inputmode="tel"', "With the country code, for example +33 6 12 34 56 78.") }}
        <div class="row">
          {{ field("date", "Date of travel", "date", "") }}
          {{ field("time", "Pick-up or flight time", "time", "") }}
        </div>
        {{ field("passengers", "Passengers", "number", 'min="1" max="20" inputmode="numeric"') }}
        {{ field("from", "From", "text", 'autocomplete="off"', "Hotel name, beach, airport or pier.") }}
        {{ field("to", "To", "text", 'autocomplete="off"') }}

        <div class="checks">
          <div class="check"><input type="checkbox" id="f-baby_seat" name="baby_seat"><label for="f-baby_seat">I need a baby seat (0 to 2 years)</label></div>
          <div class="check"><input type="checkbox" id="f-child_seat" name="child_seat"><label for="f-child_seat">I need a child seat (3 to 11 years)</label></div>
        </div>

        <div class="field">
          <label for="f-notes">Other information</label>
          <textarea id="f-notes" name="notes" rows="4"></textarea>
        </div>

        <div class="field">
          <div class="check"><input type="checkbox" id="f-consent" name="consent" required aria-describedby="e-consent"><label for="f-consent">I agree to be contacted on WhatsApp</label></div>
          <p class="err" id="e-consent" hidden></p>
        </div>

        <button class="btn" type="submit" id="send">Send my request</button>
        <p class="status" id="form-status" role="status" aria-live="polite"></p>
        <p class="after">Once we receive your request, the team contacts you on WhatsApp to confirm. Payment is made in cash to the driver on the day.</p>
      </form>

      <div class="done" id="done" hidden tabindex="-1">
        <h3>Thank you, we received your request.</h3>
        <p>Our team will confirm on WhatsApp as soon as possible.</p>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <p class="name">VIP TAXI LANTA</p>
    <p>by {{ taxi.business.owner }}</p>
    <p class="place">{{ taxi.business.place }}</p>
  </div>
</footer>

<script src="/js/taxi-form.js" defer></script>
<script src="/js/taxi.js" defer></script>
</body>
</html>
