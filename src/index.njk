    <div class="marquee-item" data-lightbox data-src="/images/IMG_9507.jpg" data-caption="Cascade d'Erawan, Kanchanaburi" aria-hidden="true"><picture><source type="image/webp" srcset="/images/thumbs/IMG_9507-700.webp"><img loading="lazy" decoding="async" src="/images/IMG_9507.jpg" alt=""></picture><span class="cap">Cascade d'Erawan</span></div>
    <div class="marquee-item" data-lightbox data-src="/images/IMG_4231.jpg" data-caption="Eaux turquoise de Koh Tao" aria-hidden="true"><picture><source type="image/webp" srcset="/images/thumbs/IMG_4231-700.webp"><img loading="lazy" decoding="async" src="/images/IMG_4231.jpg" alt=""></picture><span class="cap">Koh Tao</span></div>
    <div class="marquee-item" data-lightbox data-src="/images/IMG_2016.jpg" data-caption="Coucher de soleil sur la plage de Koh Lanta" aria-hidden="true"><picture><source type="image/webp" srcset="/images/thumbs/IMG_2016-700.webp"><img loading="lazy" decoding="async" src="/images/IMG_2016.jpg" alt=""></picture><span class="cap">Coucher de soleil · Koh Lanta</span></div>
  </div>
</section>
<div style="background:var(--bg-cream);text-align:center;padding:12px 0 24px;border-bottom:1px solid var(--line-soft)">
  <a class="text-link" href="/galerie/" style="color:var(--teal-dark);font-size:0.9rem">
