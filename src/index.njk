      <div class="hv-art-side" data-parallax="-0.08"><img loading="lazy" decoding="async" sizes="(min-width: 900px) 24vw, 50vw" src="/images/IMG_6424.jpg" alt=""></div>
      <div class="hv-art-dot" data-parallax="0.12"><img loading="lazy" decoding="async" sizes="160px" src="/images/IMG_2016.jpg" alt=""></div>
    </div>
  </div>
</section>

<section class="section-pad hv-intro">
  <div class="container hv-split">
    <div class="hv-arch" data-reveal="left"><img loading="lazy" decoding="async" src="/images/IMG_5300.jpg" alt="Anaïs à la rencontre d'un éléphant en Thaïlande"></div>
