{% block content %}{% raw %}
<!-- ============ HERO ÉDITORIAL ============ -->
<section class="home-hero" data-screen-label="Hero">
  <div class="container">
    <div class="home-hero-inner">
      <!-- Côté gauche : texte éditorial -->
      <div class="hero-editorial-left">
        <!-- Badge géo pulsant -->
        <div class="geo-badge">
          <span class="geo-dot" aria-hidden="true"></span>
          <span>Koh Lanta, Thaïlande &middot; 7°39'N 99°02'E</span>
        </div>

        <p class="eyebrow" style="margin-bottom:20px">Agence locale &middot; Sur place à Koh Lanta depuis 2021</p>

        <h1>
          Voyages sur mesure,<br>
          pensés avec le <em>cœur.</em>
        </h1>

        <p class="hero-tagline">Loin des circuits standardisés, notre agence locale compose votre itinéraire sur mesure en Thaïlande — à votre rythme, selon vos envies et votre budget, avec l'expertise et la bienveillance d'une équipe francophone sur le terrain.</p>

        <!-- Signature Zwald Travel Planner -->
        <div class="hero-signature" aria-label="Signature Zwald Travel Planner">
          <span class="sig-hand">Zwald Travel Planner</span>
          <svg class="sig-flourish" viewBox="0 0 64 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M2 5 C16 1, 38 9, 62 3" />
          </svg>
        </div>

        <div class="hero-editorial-btns">
          <a class="btn btn-teal btn-lg" href="/contact/" data-magnetic>
            <span>Composer mon voyage
              <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </a>
          <a class="btn btn-white btn-lg" href="/a-propos/">
            <span>L'esprit de l'agence</span>
          </a>
        </div>

        <!-- Preuve sociale subtile et intégrée -->
        <div class="hero-trust-proof">
          <div class="proof-stars" aria-hidden="true">★★★★★</div>
          <a class="proof-link" href="https://maps.app.goo.gl/F81WUgeET6vPxjNs8" target="_blank" rel="noopener" aria-label="Avis Google 5/5 — 50+ voyageurs accompagnés">
            <strong>5.0/5</strong> sur Google Maps &middot; <span>50+ voyageurs accompagnés</span>
          </a>
        </div>
      </div>

      <!-- Côté droit : composition photographique étagée -->
      <div class="hero-editorial-right">
        <!-- Carte panoramique principale -->
        <div class="hero-scene-card">
          <img fetchpriority="high" src="/images/IMG_6424.jpg" alt="Vue sur les îles de la mer d'Andaman, Thaïlande" width="1200" height="900">
        </div>

        <!-- Portrait en polaroid -->
        <div class="anais-portrait-wrap">
          <img fetchpriority="high" src="/images/IMG_5300.jpg" alt="Anaïs sur le terrain à Koh Lanta, Thaïlande — Zwald Travel Planner" width="800" height="1067">
          <div class="portrait-caption">Sur le terrain &middot; Koh Lanta</div>
        </div>

        <!-- Tampon vintage SVG -->
        <div class="stamp-circle" aria-hidden="true">
          <svg viewBox="0 0 120 120" fill="none">
            <circle cx="60" cy="60" r="54" stroke="#0A828D" stroke-width="2" stroke-dasharray="4 3" fill="rgba(255,255,255,0.92)"/>
            <circle cx="60" cy="60" r="46" stroke="#0A828D" stroke-width="1" fill="none"/>
            <defs>
              <path id="topArc" d="M 60,60 m -36,0 a 36,36 0 1,1 72,0" />
              <path id="botArc" d="M 60,60 m -34,0 a 34,34 0 1,0 68,0" />
            </defs>
            <text font-family="Manrope, sans-serif" font-size="7.2" font-weight="700" letter-spacing="3" fill="#0A828D" text-anchor="middle">
              <textPath href="#topArc" startOffset="50%">SUR LE TERRAIN · 3+ ANS</textPath>
            </text>
            <text font-family="Manrope, sans-serif" font-size="6.8" font-weight="600" letter-spacing="2.2" fill="#0A828D" text-anchor="middle">
              <textPath href="#botArc" startOffset="50%">KOH LANTA · THAÏLANDE</textPath>
            </text>
            <text x="60" y="56" text-anchor="middle" font-family="Cormorant Garamond, serif" font-size="15" font-weight="600" fill="#0A828D" font-style="italic">Zwald</text>
            <text x="60" y="69" text-anchor="middle" font-family="Manrope, sans-serif" font-size="6.2" font-weight="700" letter-spacing="1.2" fill="#0A828D">TRAVEL PLANNER</text>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ BENTO GRID ============ -->
<section class="section-pad">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">L'accompagnement Zwald</p>
      <h2>Pourquoi voyager avec une équipe <em>sur place</em> ?</h2>
      <p>Une agence locale à taille humaine, sans intermédiaires. Un regard de terrain, une présence continue et une vraie relation humaine, du premier échange au retour de voyage.</p>
    </div>
    <div class="bento-grid">
      <!-- Bloc A : Photo terrain -->
      <div class="bento-a" data-reveal>
        <img loading="lazy" decoding="async" src="/images/IMG_5519.jpg" alt="Exploration et repérage terrain dans la mangrove, Thaïlande" width="1200" height="800">
        <div class="bento-overlay" aria-hidden="true"></div>
        <div class="bento-content">
          <div class="bento-badge">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="5"/></svg>
            Sur le terrain
          </div>
          <blockquote>&ldquo;Chaque adresse que nous recommandons, notre équipe l'a découverte et testée sur le terrain. Chaque itinéraire a été pensé pour vous.&rdquo;</blockquote>
        </div>
      </div>

      <!-- Bloc B : 0% commission -->
      <div class="bento-b" data-reveal data-reveal-delay="1">
        <div>
          <div class="bento-zero">0%</div>
          <div class="bento-b-title">De commission. Jamais.</div>
          <p>Vous réservez directement auprès des hébergements et partenaires locaux, en totale liberté. Nous vous conseillons sans aucun conflit d'intérêt — notre seule priorité, c'est votre voyage.</p>
        </div>
        <a class="bento-arrow-link" href="/services/">
          Notre approche
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <!-- Bloc C : Carnet numérique -->
      <div class="bento-c" data-reveal data-reveal-delay="2">
        <div class="bento-c-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 5a2 2 0 012-2h9l5 5v11a2 2 0 01-2 2H6a2 2 0 01-2-2z"/><path d="M14 3v5h5M8 13h8M8 17h5"/></svg>
        </div>
        <h3>Votre carnet de voyage numérique</h3>
        <p>Itinéraire jour par jour, réservations directes, pépites locales et repères culturels. Un guide complet dans votre poche, accessible partout, même hors connexion.</p>
        <a class="text-link" href="/services/">Voir ce qui est inclus <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>

      <!-- Bloc D : WhatsApp conversation -->
      <div class="bento-d" data-reveal data-reveal-delay="3">
        <div class="wa-header">
          <img class="wa-avatar" src="/images/thumbs/IMG_5300-700.webp" alt="Anaïs, coordinatrice chez Zwald Travel Planner" width="46" height="46">
          <div>
            <div class="wa-name">Anaïs <span class="online" aria-label="En ligne"></span></div>
            <div class="wa-status">Coordinatrice séjours &middot; Koh Lanta</div>
          </div>
        </div>
        <div class="wa-convo" role="log" aria-label="Exemple d'assistance locale pendant le voyage">
          <div class="wa-msg received">
            Coucou Sophie ! 🌴 La mer est parfaite aujourd'hui, j'ai prévenu Somchai pour ton bateau à 10h. Bon snorkeling !
            <span class="wa-time">09:42</span>
          </div>
          <div class="wa-msg sent">
            Vous êtes incroyables, merci pour tout ❤️
            <span class="wa-time">09:48</span>
          </div>
          <div class="wa-msg received">
            Avec plaisir ! N'oublie pas la crème solaire 😄 L'équipe reste dispo si besoin.
            <span class="wa-time">09:50</span>
          </div>
        </div>
        <p class="wa-caption">Une présence francophone 7j/7 pendant votre séjour — votre relais de confiance sur place.</p>
      </div>
    </div>
  </div>
</section>

