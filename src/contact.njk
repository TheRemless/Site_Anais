{% block content %}{% raw %}
<section class="page-hero has-img" data-screen-label="Contact — hero">
  <div class="ph-bg" data-parallax="0.1"><img fetchpriority="high" src="images/IMG_4231.jpg" alt="Eaux turquoise de Thaïlande" width="1200" height="1600"></div>
  <div class="ph-overlay"></div>
  <div class="container">
    <p class="eyebrow">Contact</p>
    <h1>Parlons de ton prochain voyage</h1>
    <p>Au tout début de ta réflexion ou déjà une idée précise ? Je serai ravie de t'accompagner.</p>
  </div>
</section>

<section class="section-pad">
  <div class="container">
    <div class="contact-layout">
      <div data-reveal="left">
        <div class="contact-form">
          <form id="contactForm" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="contact">
            <p style="display:none"><label>Ne pas remplir : <input name="bot-field"></label></p>
            <div class="form-row">
              <div class="field"><label for="name">Ton prénom</label><input type="text" id="name" name="name" placeholder="Ex : Sophie" required></div>
              <div class="field"><label for="email">Ton email</label><input type="email" id="email" name="email" placeholder="sophie@email.com" required></div>
            </div>
            <div class="field"><label for="phone">Ton numéro de téléphone</label><input type="tel" id="phone" name="phone" placeholder="Ex : +33 6 12 34 56 78" required></div>
            <div class="field"><label for="subject">Sujet</label>
              <select id="subject" name="subject">
                <option>Voyage sur mesure</option>
                <option>Demande de devis</option>
                <option>Appel découverte</option>
                <option>Cours de thaï</option>
                <option>Carte cadeau</option>
                <option>Mini-guide PDF</option>
                <option>Autre question</option>
              </select>
            </div>
            <div class="field"><label for="message">Ton message</label><textarea id="message" name="message" placeholder="Parle-moi de ton projet : tes dates, ton budget, le nombre de voyageurs, tes envies… ou pose-moi tes questions." required></textarea></div>
            <button type="submit" class="btn btn-teal btn-lg" style="width:100%;justify-content:center"><span>Envoyer mon message</span></button>
            <p style="text-align:center;font-size:0.82rem;color:var(--ink-faint);margin-top:14px">Réponse généralement sous 24-48h · Devis gratuit et sans engagement</p>
            <p style="text-align:center;font-size:0.84rem;margin-top:10px">
              Tu as des questions avant d'écrire ?
              <a class="text-link" href="faq.html" style="font-size:0.84rem">Consulte la FAQ
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </p>
          </form>
          <div class="form-success" id="formSuccess" style="display:none">
            <div class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M20 6L9 17l-5-5"/></svg></div>
            <h3>Message envoyé !</h3>
            <p class="mt-s" style="color:var(--ink-mute)" id="successMsg">Merci pour ton message ! Je te réponds dans les plus brefs délais (généralement sous 24-48h).</p>
            <button class="btn btn-ghost mt-m" type="button" onclick="document.getElementById('formSuccess').style.display='none';document.getElementById('contactForm').style.display='block';document.getElementById('contactForm').reset();"><span>Envoyer un autre message</span></button>
          </div>
        </div>
      </div>

      <div class="contact-side" data-reveal="right">
        <div class="contact-testi">
          <div class="stars" aria-label="5 étoiles sur 5">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.8 6.1 20.8l1.2-6.6L2.5 9l6.6-.9z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.8 6.1 20.8l1.2-6.6L2.5 9l6.6-.9z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.8 6.1 20.8l1.2-6.6L2.5 9l6.6-.9z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.8 6.1 20.8l1.2-6.6L2.5 9l6.6-.9z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.8 6.1 20.8l1.2-6.6L2.5 9l6.6-.9z"/></svg>
          </div>
          <blockquote>"Un immense merci à Anaïs ! Des vacances exceptionnelles tout en faisant de belles économies !"</blockquote>
          <cite>Sophie — Voyage solo · Koh Lanta</cite>
        </div>
        <div class="contact-card">
          <span class="ic"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm0 1.8a8.2 8.2 0 016.9 12.6l-.2.3.8 2.9-3-.8-.3.2A8.2 8.2 0 1112 3.8z"/></svg></span>
          <div><strong>WhatsApp</strong><a href="https://wa.me/66958683846" target="_blank" rel="noopener">+66 95 868 38 46</a><p style="margin-top:4px">Pour les questions rapides</p></div>
        </div>
        <div class="contact-card">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 1.9.7 2.8a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.5c.9.3 1.8.6 2.8.7a2 2 0 011.7 2z"/></svg></span>
          <div><strong>Appel découverte</strong><p>Gratuit et sans engagement</p><p style="margin-top:2px;font-size:0.85rem;color:var(--ink-faint)">Choisis « Appel découverte » dans le formulaire</p></div>
        </div>
        <div class="contact-card">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></span>
          <div><strong>Réseaux sociaux</strong>
            <div style="display:flex;gap:14px;margin-top:6px">
              <a href="https://www.instagram.com/zwaldtravelplanner/" target="_blank" rel="noopener">Instagram</a>
              <a href="https://www.facebook.com/people/Zwald-Travel-Planner/61568573411432/" target="_blank" rel="noopener">Facebook</a>
            </div>
          </div>
        </div>
        <div class="contact-card" style="background:var(--bg-mint);border-color:var(--line)">
          <span class="ic" style="background:#fff"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 12v7a2 2 0 01-2 2H6a2 2 0 01-2-2v-7M2 7h20v5H2zM12 21V7M12 7S9 2 6.5 3.5 9 7 12 7zM12 7s3-5 5.5-3.5S15 7 12 7z"/></svg></span>
          <div><strong>Cartes cadeaux voyage</strong><p>Anniversaire, mariage, Noël… 100% personnalisables, elles donnent accès à tous mes services.</p></div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endraw %}{% endblock %}

{% block scripts %}{% raw %}
<script>
  ZWALD.init({ page: "contact" });
  document.getElementById("contactForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var form = this;
    var name = document.getElementById("name").value.trim();
    // Confirmation immédiate (UX), puis envoi réel vers Netlify Forms en arrière-plan
    document.getElementById("successMsg").textContent =
      "Merci pour ton message" + (name ? ", " + name : "") + " ! Je te réponds dans les plus brefs délais (généralement sous 24-48h).";
    form.style.display = "none";
    document.getElementById("formSuccess").style.display = "block";
    var data = new URLSearchParams(new FormData(form)).toString();
    fetch("/", { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: data })
      .catch(function () { /* Netlify réessaiera ; la confirmation est déjà affichée */ });
  });
</script>
{% endraw %}{% endblock %}
